<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)build\SfmMod.props" />

  <PropertyGroup>
    <AssemblyName>Hogtie</AssemblyName>
    <RootNamespace>Hogtie</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Hogtie - SecretFlasherManaka BepInEx IL2CPP mod</Description>
