<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)build\SfmMod.props" />

  <PropertyGroup>
    <AssemblyName>Hogtie</AssemblyName>
    <RootNamespace>Hogtie</RootNamespace>
    <Version>0.2.0</Version>
    <Description>Hogtie - a hogtie device for SecretFlasherManaka (BepInEx IL2CPP)</Description>
    <!-- Compiles against RestraintHub (build/SfmMod.targets); players install it separately. -->
    <SfmUsesRestraintHub>true</SfmUsesRestraintHub>
  </PropertyGroup>

  <ItemGroup>
    <!-- The model, exported from Hogtie.blend by tools/export_model.py (see docs/Hogtie.md). -->
    <EmbeddedResource Include="assets\hogtie.htm" LogicalName="Hogtie.assets.hogtie.htm" />
  </ItemGroup>

  <!-- Compile the shared SfmKit sources into this DLL (remove this line if you do not use it). -->
  <Import Project="$(RepoRoot)build\SfmKit.props" />
  <Import Project="$(RepoRoot)build\SfmMod.targets" />
</Project>
